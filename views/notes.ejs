<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.body, {
          delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false},
              {left: '\\[', right: '\\]', display: true}
          ]
        });"></script>
</head>

<body>
  <%- include('partials/navbar') %>

  <div class="notes-layout">

    <aside class="notes-sidebar">
      <h3>Topics & Notes</h3>
      <ul>
        <li>
          <a href="/notes" class="<%= activeTopic === 'index' ? 'active' : '' %>">
            Overview
          </a>
        </li>
        <li>
          <a href="/notes/hungerford-algebra" class="<%= activeTopic === 'hungerford-algebra' ? 'active' : '' %>">
            Hungerford Algebra
          </a>
        </li>
        <li>
          <a href="/notes/ap-computer-science-a" class="<%= activeTopic === 'ap-computer-science-a' ? 'active' : '' %>">
            AP Computer Science A
          </a>
        </li>
        <li>
          <a href="/notes/real-analysis" class="<%= activeTopic === 'real-analysis' ? 'active' : '' %>">
            Real Analysis
          </a>
        </li>
      </ul>
    </aside>

<main class="notes-content">

      <% if (locals.noteData) { %>
      <!-- Sadece Markdown Dosyası Varsa Burası Çalışır -->
      <div class="markdown-body">
        <%- noteData.htmlBody %>
      </div>

      <% } else if (activeTopic === 'index') { %>
      <!-- YENİ EKLENEN KISIM: Ayrı dosyadan index'i çağırıyoruz -->
      <%- include('notes-index') %>

      <% } else { %>
      <!-- Dosya Bulunamazsa Çıkacak Hata -->
      <div class="notes-error-box">
        <h2 class="notes-error-title">Note Not Found</h2>
        <p>The note you are looking for does not exist or has been moved.</p>
      </div>
      <% } %>

    </main>

  </div>

  <%- include('partials/footer') %>
</body>

</html>