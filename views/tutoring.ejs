<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="tutoring-content">

        <section class="stem-intro">
            <h1><%= __('tutoring_page.stem_intro_title') %></h1>
            <p><%= __('tutoring_page.stem_intro_desc') %></p>
            
            <div class="highlight-badges">
                <div class="feature-badge">
                    <i class="fas fa-globe"></i> <%= __('tutoring_page.badge_language') %>
                </div>
                <div class="feature-badge">
                    <i class="fas fa-laptop"></i> <%= __('tutoring_page.badge_online') %>
                </div>
                <div class="feature-badge">
                    <i class="fas fa-clock"></i> <%= __('tutoring_page.badge_duration') %>
                </div>
            </div>
        </section>

        <section class="program-links">
            <h2 class="section-title"><%= __('tutoring_page.programs_title') %></h2>
            <div class="program-grid">
                <% programColumns.forEach(function(column) { %>
                <div class="program-col">
                    <% column.forEach(function(card) { %>
                    <article class="program-card">
                        <h3><a href="<%= card.href %>"><%= card.title %></a></h3>
                        <p class="program-card-lead"><%= card.lead %></p>
                        <% card.groups.forEach(function(group) { %>
                            <% if (group.label) { %><p class="program-card-group"><%= group.label %></p><% } %>
                            <ul class="program-chips">
                                <% group.courses.forEach(function(course) { %>
                                    <li><a href="<%= course.href %>"><%= course.title %></a></li>
                                <% }) %>
                            </ul>
                        <% }) %>
                        <% if (card.also.length) { %>
                            <p class="program-card-also"><strong><%= card.alsoLabel %>:</strong> <%= card.also.join(' · ') %></p>
                        <% } %>
                        <a class="program-link-more" href="<%= card.href %>"><%= __('tutoring_page.program_more') %> <i class="fas fa-arrow-right"></i></a>
                    </article>
                    <% }) %>
                </div>
                <% }) %>
            </div>
        </section>

        <section class="exam-programs-section">
            <h2 class="section-title"><%= __('tutoring_page.exam_prep_title') %></h2>
            
            <div class="exam-grid">
                <div class="exam-card border-blue">
                    <h3><i class="fas fa-calendar-days exam-card-icon"></i><%= __('tutoring_page.exam_flexible_title') %></h3>
                    <p><%- __('tutoring_page.exam_flexible_desc') %></p>
                </div>

                <div class="exam-card border-green">
                    <h3><i class="fas fa-chart-column exam-card-icon"></i><%= __('tutoring_page.exam_mock_title') %></h3>
                    <p><%- __('tutoring_page.exam_mock_desc') %></p>
                </div>

                <div class="exam-card border-orange">
                    <h3><i class="fas fa-bullseye exam-card-icon"></i><%= __('tutoring_page.exam_strategic_title') %></h3>
                    <p><%- __('tutoring_page.exam_strategic_desc') %></p>
                </div>

                <div class="exam-card border-purple">
                    <h3><i class="fas fa-star exam-card-icon"></i><%= __('tutoring_page.exam_guarantee_title') %></h3>
                    <p><%- __('tutoring_page.exam_guarantee_desc') %></p>
                </div>
            </div>
        </section>

        <% if (currentLang === 'tr') { %>
        <div class="giving-back-notice">
            <h3 class="giving-back-title">
                <span class="giving-back-icon">🌱</span> <%= __('tutoring_page.giving_back_title') %>
            </h3>
            <p class="giving-back-text">
                <%- __('tutoring_page.giving_back_text') %>
            </p>
        </div>
        <% } %>

        <section class="home-reviews">
            <h2 class="home-reviews-title"><%= __('about_page.testimonials_title') %></h2>
            <div class="home-reviews-grid">
                <% featuredReviews.forEach(function(review) { %>
                    <div class="testimonial-card home-review-card">
                        <p class="student-text"><%= __('testimonials.t' + review.number + '_text') %></p>
                        <div class="student-name"><%= review.name %></div>
                        <div class="student-school"><%= __('testimonials.t' + review.number + '_subject') %></div>
                    </div>
                <% }) %>
            </div>
            <p class="testimonials-source">
                <%= __('about_page.testimonials_source') %>
                <a href="<%= localUrl('/about#testimonials') %>"><%= __('tutoring_page.reviews_all') %></a>
            </p>
        </section>
    </main>

    <div class="university-slider-fullwidth exam-slider">
        <div class="slider-track exam-track">
            <% for (let copy = 0; copy < 4; copy++) { %>
                <% exams.forEach(function(exam) { %>
                    <a class="text-card exam-badge" href="<%= localUrl(exam.href) %>"<%- copy > 0 ? ' aria-hidden="true" tabindex="-1"' : '' %>>
                        <img class="exam-badge-img" src="/img/logos/exams/<%= exam.slug %>.png" alt="" loading="lazy">
                        <span><%= exam.label %></span>
                    </a>
                <% }) %>
            <% } %>
        </div>
    </div>

    <div class="university-slider-fullwidth">
        <div class="slider-track">
            <% for (let copy = 0; copy < 2; copy++) { %>
                <% universities.forEach(function(university) { %>
                    <div class="text-card<%= university.logo ? (university.wordmark ? ' has-logo logo-only' : ' has-logo') : '' %>"<%- copy > 0 ? ' aria-hidden="true"' : '' %>>
                        <% if (university.logo) { %>
                            <img class="university-logo" src="<%= university.logo %>" alt="<%= university.wordmark ? university.name : '' %>" loading="lazy">
                        <% } %>
                        <% if (!(university.logo && university.wordmark)) { %>
                            <span><%= university.name %></span>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
    <%- include('partials/footer') %>
</body>
</html>