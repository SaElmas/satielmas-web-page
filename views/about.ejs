<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/navbar') %>

  <main class="main-container">

    <section class="hero-section">
      <h1 class="hero-title"><%= __('hero_title') %></h1>
      <p class="hero-subtitle">
        <%- __('hero_subtitle') %>
      </p>
    </section>

    <div class="about-grid">

      <div class="grid-card">
        <h2 class="section-title-blue"><%= __('about_page.journey_title') %></h2>
        <p class="content-text"><%- __('about_page.journey_p1') %></p>
        <p class="content-text"><%- __('about_page.journey_p2') %></p>
        <p class="content-text"><%- __('about_page.journey_p3') %></p>
        <p class="content-text"><%- __('about_page.journey_p4') %></p>
      </div>

      <div class="grid-card">
        <h2 class="section-title-green"><%= __('about_page.beyond_title') %></h2>

        <div class="image-wrapper">
          <img src="/img/sait-mentor.jpg" alt="Sait Elmas" class="profile-image">
        </div>

        <p class="content-text"><%- __('about_page.beyond_p1') %></p>
        <p class="content-text"><%- __('about_page.beyond_p2') %></p>
      </div>

    </div>

    <section class="testimonials-section">
      <h2 class="testimonials-title"><%= __('about_page.testimonials_title') %></h2>

      <p class="testimonials-source">
        <%= __('about_page.testimonials_source') %>
        <a href="https://ankara.ozelders.com/ders-veren/gemi-insa-muhendisi-sait-e-324085" target="_blank" rel="noopener"><%= __('about_page.testimonials_source_link') %></a>
      </p>

      <%# ozelders.com profilindeki gerçek yorumlar; metinler locales/*.json içinde (t1..t13) %>
      <% const reviewers = ["Elif V.","Kaan B.","Pınar D.","Cinar K.","Berkan Ö.","Edibe Ö.","Arhan T.","Zeynep A.","Mine T.","Emin K.","Muhammed Eren G.","Kaan C.","Halil K."]; %>
      <div class="testimonial-container">
        <div class="testimonial-track">
          <% for (let copy = 0; copy < 2; copy++) { %>
            <% reviewers.forEach(function(name, index) { %>
              <div class="testimonial-card"<%- copy > 0 ? ' aria-hidden="true"' : '' %>>
                <p class="student-text"><%= __('testimonials.t' + (index + 1) + '_text') %></p>
                <div class="student-name"><%= name %></div>
                <div class="student-school"><%= __('testimonials.t' + (index + 1) + '_subject') %></div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>

</html>