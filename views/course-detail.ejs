<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="course-detail-main">
        <section class="card course-card-section">
            <header class="course-header">
                <% if (courseBadge) { %>
                    <img class="course-badge" src="<%= courseBadge %>" alt="">
                <% } %>
                <div class="course-header-text">
                    <% if (programUrl) { %>
                        <a class="course-category-label" href="<%= programUrl %>"><%= course.category[currentLang] %></a>
                    <% } else { %>
                        <p class="course-category-label"><%= course.category[currentLang] %></p>
                    <% } %>
                    <h1 class="course-title"><%= course.title[currentLang] %></h1>
                    <p class="course-description">
                        <%- course.description[currentLang] %>
                    </p>
                </div>
            </header>

            <div class="course-grid">
                <div class="course-info-box">
                    <h2 class="course-info-title"><%= __('course_detail.lbl_curriculum') %></h2>
                    <ol class="course-syllabus-list">
                        <% if (course.syllabus && course.syllabus[currentLang]) { %>
                            <% course.syllabus[currentLang].forEach(function(item) { %>
                                <li><%- item %></li>
                            <% }) %>
                        <% } %>
                    </ol>
                </div>

                <div class="course-side">
                    <div class="course-info-box">
                        <h2 class="course-info-title"><%= __('course_detail.lbl_strategy') %></h2>
                        <p class="course-strategy-text">
                            <%- course.examInfo[currentLang] %>
                        </p>
                    </div>

                    <% if (course.resources && course.resources.length) { %>
                    <div class="course-info-box">
                        <h2 class="course-info-title"><%= __('course_detail.lbl_resources') %></h2>
                        <ul class="course-resource-list">
                            <% course.resources.forEach(function(resource) { %>
                                <li>
                                    <a href="<%= localUrl(resource.href) %>">
                                        <i class="fas fa-book-open"></i>
                                        <span><%= resource.label[currentLang] %></span>
                                        <i class="fas fa-arrow-right course-resource-arrow"></i>
                                    </a>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                    <% } %>

                    <a href="<%= localUrl('/contact') %>" class="course-trial-btn">
                        <%= __('course_detail.btn_trial') %>
                    </a>
                </div>
            </div>

            <% if (lessonPlan) { %>
            <section class="lesson-plan">
                <h2 class="lesson-plan-heading"><%= lessonPlan.labels.heading %></h2>
                <h3 class="lesson-plan-title"><%= lessonPlan.title %></h3>
                <% lessonPlan.intro.forEach(function(paragraph) { %>
                    <p class="lesson-plan-intro"><%= paragraph %></p>
                <% }) %>

                <ul class="lesson-plan-meta">
                    <li><strong><%= lessonPlan.labels.totalLessons %>:</strong> <%= lessonPlan.total %></li>
                    <li><strong><%= lessonPlan.labels.duration %>:</strong> <%= lessonPlan.minutes %> <%= lessonPlan.labels.minutes %></li>
                </ul>

                <div class="course-info-box lesson-plan-flow">
                    <h3 class="program-format-title"><i class="fas fa-clock"></i> <%= lessonPlan.labels.flow %></h3>
                    <ul>
                        <% lessonPlan.flow.forEach(function(step) { %>
                            <li><span class="lesson-plan-time"><%= step.time %> <%= lessonPlan.labels.minutes %></span> <%= step.text %></li>
                        <% }) %>
                    </ul>
                </div>

                <% lessonPlan.parts.forEach(function(part, index) { %>
                <details class="lesson-plan-part"<%= index === 0 ? ' open' : '' %>>
                    <summary>
                        <span class="lesson-plan-part-title"><%= part.title %></span>
                        <span class="lesson-plan-range"><%= lessonPlan.labels.lessons %> <%= part.range %></span>
                    </summary>
                    <p class="lesson-plan-note"><%= part.note %></p>
                    <ol class="lesson-plan-list">
                        <% part.lessons.forEach(function(lesson) { %>
                            <li class="lesson-plan-item lesson-kind-<%= lesson.kind %>">
                                <span class="lesson-plan-number"><%= lessonPlan.labels.lesson %> <%= lesson.number %></span>
                                <div>
                                    <span class="lesson-plan-label"><%= lesson.prefix %><%= lesson.label %></span>
                                    <span class="lesson-plan-text"><%= lesson.text %></span>
                                </div>
                            </li>
                        <% }) %>
                    </ol>
                </details>
                <% }) %>
            </section>
            <% } %>

            <div class="course-back-container">
                <a href="<%= localUrl('/tutoring') %>" class="course-back-link"><%= __('course_detail.link_back') %></a>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>