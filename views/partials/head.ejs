<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= locals.pageTitle || 'Sait Elmas | Math & CS Tutoring' %></title>

<meta name="description" content="<%= locals.pageDescription || __('meta.default') %>">
<link rel="canonical" href="<%= canonicalUrl %>">
<% if (locals.hreflang !== false) { %>
<link rel="alternate" hreflang="en" href="<%= siteUrl + altUrls.en %>">
<link rel="alternate" hreflang="tr" href="<%= siteUrl + altUrls.tr %>">
<link rel="alternate" hreflang="x-default" href="<%= siteUrl + altUrls.en %>">
<% } %>

<link rel="icon" type="image/png" href="/img/logos/favicon.png?v=5.2">
<link rel="shortcut icon" type="image/png" href="/img/logos/favicon.png?v=5.2">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<% [baseSchema].concat(locals.jsonLd || []).forEach(function(schema) { %>
<script type="application/ld+json"><%- JSON.stringify(schema).replace(/</g, '\\u003c') %></script>
<% }) %>

<meta property="og:title" content="<%= locals.pageTitle || 'Sait Elmas | Math & CS Tutoring' %>">
<meta property="og:description" content="<%= locals.pageDescription || __('meta.default') %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<meta property="og:type" content="website">
<meta property="og:locale" content="<%= currentLang === 'tr' ? 'tr_TR' : 'en_US' %>">
<meta property="og:image" content="https://saitelmas.com/img/logos/logo.png">
<meta property="og:image:type" content="image/png">

<link rel="stylesheet" href="/css/style.css?v=4.6">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">